    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Fable.Core" Version="5.0.0" /></ItemGroup>
  <Import Project="Sources.props" />
