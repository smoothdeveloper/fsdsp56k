<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Dsp56k.Tests</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- source ranges in kernel quotations: the compiled listings quote the F# lines -->
    <OtherFlags>$(OtherFlags) --quotations-debug+</OtherFlags>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Kernels/Sine.fs" />
    <Compile Include="Kernels/InputThru.fs" />
    <Compile Include="Kernels/MainTap.fs" />
    <Compile Include="Kernels/Pluck.fs" />
    <Compile Include="Kernels/Tx6BdTables.fs" />
    <Compile Include="Kernels/Tx6Bd.fs" />
    <Compile Include="Kernels/Tx6TomTables.fs" />
    <Compile Include="Kernels/Tx6Tom.fs" />
    <Compile Include="Kernels/Tx6MetalTables.fs" />
    <Compile Include="Kernels/Tx6Metal.fs" />
    <Compile Include="Kernels/Tx6SdTables.fs" />
    <Compile Include="Kernels/Tx6Sd.fs" />
    <Compile Include="Kernels/Tx6CpTables.fs" />
    <Compile Include="Kernels/Tx6Cp.fs" />
    <Compile Include="Kernels/Grading.fs" />
    <Compile Include="Fixtures.fs" />
    <Compile Include="Catalogue.fs" />
    <Compile Include="OracleTests.fs" />
    <Compile Include="GoldTests.fs" />
    <Compile Include="EmulatorTests.fs" />
    <Compile Include="CorpusTests.fs" />
    <Compile Include="ImportTests.fs" />
    <Compile Include="ToolTests.fs" />
    <Compile Include="KernelTests.fs" />
    <Compile Include="HandTests.fs" />
    <Compile Include="KernelIrTests.fs" />
    <Compile Include="IrFrontEndTests.fs" />
    <Compile Include="TypedTreeFrontEndTests.fs" />
    <Compile Include="SweepTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/dsp56k/dsp56k.fsproj" />
    <ProjectReference Include="../../src/dsp56k.native/dsp56k.native.fsproj" />
    <ProjectReference Include="../../src/machinedrum/machinedrum.fsproj" />
    <ProjectReference Include="../../src/machinedrum.run/machinedrum.run.fsproj" />
    <ProjectReference Include="../../src/dsp56k.tool/dsp56k.tool.fsproj" />
    <ProjectReference Include="../../src/dsp56k.audio/dsp56k.audio.fsproj" />
    <ProjectReference Include="../../src/dsp56k.kernel.intrinsics/dsp56k.kernel.intrinsics.fsproj" />
    <ProjectReference Include="../../src/dsp56k.kernel/dsp56k.kernel.fsproj" />
    <ProjectReference Include="../../src/dsp56k.kernel.typedtree/dsp56k.kernel.typedtree.fsproj" />
    <ProjectReference Include="../../src/dsp56k.kernel.grade/dsp56k.kernel.grade.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>