<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Dsp56k.Native</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Native.fs" />
    <Compile Include="Disassembler.fs" />
  </ItemGroup>

  <!-- the emulator built in native/ (a cargo release build), for the packages' users: runtimes/<rid>/native -->
  <PropertyGroup>
    <NativeLibraryFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">libfsdsp56k_native.dylib</NativeLibraryFile>
    <NativeLibraryFile Condition="$([MSBuild]::IsOSPlatform('Linux'))">libfsdsp56k_native.so</NativeLibraryFile>
    <NativeLibraryFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">fsdsp56k_native.dll</NativeLibraryFile>
    <NativeLibraryPath>$(MSBuildThisFileDirectory)../../native/target/release/$(NativeLibraryFile)</NativeLibraryPath>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(NativeLibraryPath)')">
    <None Include="$(NativeLibraryPath)" Pack="true" PackagePath="runtimes/$(NETCoreSdkRuntimeIdentifier)/native/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../dsp56k/dsp56k.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>