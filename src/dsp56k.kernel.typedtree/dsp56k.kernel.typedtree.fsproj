<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Dsp56k.Kernel.TypedTree</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Json.fs" />
    <Compile Include="TypedTreeJson.fs" />
    <Compile Include="FromTypedTree.fs" />
    <Compile Include="FromJson.fs" />
    <Compile Include="ReflectionHost.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../dsp56k.kernel/dsp56k.kernel.fsproj" />
    <ProjectReference Include="../dsp56k.kernel.intrinsics/dsp56k.kernel.intrinsics.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
