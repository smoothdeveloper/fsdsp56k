<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Machinedrum.Run</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Services.fs" />
    <Compile Include="Track.fs" />
    <Compile Include="Wav.fs" />
    <Compile Include="Import.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../dsp56k/dsp56k.fsproj" />
    <ProjectReference Include="../dsp56k.dsl/dsp56k.dsl.fsproj" />
    <ProjectReference Include="../dsp56k.native/dsp56k.native.fsproj" />
    <ProjectReference Include="../machinedrum/machinedrum.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>